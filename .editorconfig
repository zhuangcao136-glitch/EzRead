root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{js,css,html,json,yaml,yml,vbs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,vbs}]
end_of_line = crlf

[*.ps1]
charset = utf-8-bom
